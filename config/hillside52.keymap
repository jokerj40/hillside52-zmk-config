#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define QWERTY_L 0
#define DVORAK_L 1
#define COLEMK_L 2
#define NAV_L    3
#define SYM_L    4
#define ADJ_L    5
#define Undo   LC(Z)
#define Cut    LC(X)
#define Copy   LC(C)
#define Paste  LC(V)
#define Redo   LC(Y)

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            /* QWERTY
 * -------------------------------------------------------------------------------------------------------------------------------------
 * | `     |   Q   |   W   |   E   |   R   |   T   |-----------------------------------|   Y   |   U   |   I   |   O   |   P   | BKSPC |
 * | TAB   |   A   |   S   |   D   |   F   |   G   |-----------------------------------|   H   |   J   |   K   |   L   |   ;   | ENTER |
 * | SHIFT |   Z   |   X   |   C   |   V   |   B   |   '   |-------------------|   /   |   N   |   M   |   ,   |   .   |  Up   | SHIFT |
 * | Mute  |  ESC  | CTRL  |-------|  GUI  |  ALT  |SK SHFT|  Nav  |---|  Sym  | SPACE |  ALT  |  GUI  |-------| Left  | Down  | Right |
 */

            bindings = <
&kp GRAVE  &kp Q          &kp W     &kp E  &kp R     &kp T                                            &kp Y    &kp U     &kp I      &kp O     &kp P     &kp LEFT_BRACKET
&kp TAB    &kp A          &kp S     &kp D  &kp F     &kp G                                            &kp H    &kp J     &kp K      &kp L     &kp SEMI  &kp RIGHT_BRACKET
&kp LSHFT  &kp Z          &kp X     &kp C  &kp V     &kp B  &kp SQT                        &kp SLASH  &kp N    &kp M     &kp COMMA  &kp DOT   &kp UP    &kp RSHFT
&kp LCTRL  &kp BACKSLASH  &kp LALT         &kp LGUI  &none  &kp SPACE  &kp ENTER  &kp ESC  &kp BSPC   &kp DEL  &kp RGUI             &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        layer_lower {
            bindings = <
&kp TILDE               &none            &none        &kp HASH          &kp DOLLAR  &kp PLUS                                     &kp SLASH      &kp AMPS          &kp MINUS              &none     &none      &none
&mt LEFT_CONTROL CARET  &kp EXCLAMATION  &kp AT_SIGN  &kp LPAR          &kp LBRC    &kp PERCENT                                  &kp ASTRK      &kp RIGHT_BRACE   &kp RIGHT_PARENTHESIS  &kp PIPE  &kp COLON  &kp DQT
&mt LEFT_ALT EQUAL      &none            &none        &kp LEFT_BRACKET  &kp LT      &kp UNDER    &none                   &none   &kp BACKSLASH  &kp GREATER_THAN  &kp RIGHT_BRACKET      &none     &kp QMARK  &none
&trans                  &none            &none                          &lt 3 TAB   &trans       &trans  &trans  &trans  &trans  &lt 3 DEL      &trans                                   &trans    &none      &trans
            >;
        };

        layer_raise {
            bindings = <
&kp C_VOLUME_UP             &kp F1    &kp F2     &kp F3     &kp F4   &kp F5                                          &kp F6           &kp F7    &kp F8    &kp F9  &kp F10    &kp F11
&mt LCTRL C_MUTE            &kp HOME  &kp PG_UP  &kp PG_DN  &kp END  &none                                           &kp PRINTSCREEN  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp F12
&mt LEFT_ALT C_VOLUME_DOWN  &kp N1    &kp N2     &kp N3     &kp N4   &kp N5  &none                           &none   &kp N6           &kp N7    &kp N8    &kp N9  &kp N0     &none
&trans                      &none     &none                 &trans   &trans  &trans  &lt 3 ENTER  &lt 3 ESC  &trans  &trans           &trans              &trans  &none      &trans
            >;
        };

        layer_adjust {
            bindings = <
&sys_reset  &none         &none         &none         &none         &none                                &none         &none         &none         &none         &none         &sys_reset
&none       &none         &none         &none         &none         &none                                &none         &none         &none         &none         &none         &none
&none       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 3  &bt BT_SEL 4  &none  &none                  &none  &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&bt BT_CLR  &none         &none                       &trans        &none  &none  &trans  &trans  &none  &trans        &none                       &none         &none         &bt BT_CLR
            >;
        };
    };
};
